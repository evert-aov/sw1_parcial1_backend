import 'dart:convert';
import 'package:dio/dio.dart';
import '../../../../core/network/api_client.dart';
import '../models/chat_message.dart';
import 'local_llm_service.dart';

class EntitySchema {
  final String name;
  final String singular;
  final String plural;
  final String endpoint;
  final List<FieldSchema> fields;

  const EntitySchema({
    required this.name,
    required this.singular,
    required this.plural,
    required this.endpoint,
    required this.fields,
  });
}

class FieldSchema {
  final String name;
  final String type; // 'String', 'int', 'double', 'bool', 'DateTime'
  final bool isId;
  final bool isNullable;

  const FieldSchema({
    required this.name,
    required this.type,
    this.isId = false,
    this.isNullable = true,
  });
}

class AiAssistantService {
  final ApiClient apiClient;
  LocalLlmService? _localLlmService;

  void setLocalLlmService(LocalLlmService service) {
    _localLlmService = service;
  }

  AiAssistantService({
    required this.apiClient,
  });

  // Definición de las entidades generadas a partir del modelo UML
  final List<EntitySchema> entities = const [
{{#entities}}
    EntitySchema(
      name: '{{name}}',
      singular: '{{singular}}',
      plural: '{{plural}}',
      endpoint: '/{{endpoint}}',
      fields: [
{{#fields}}
        FieldSchema(
          name: '{{name}}',
          type: '{{type}}',
          isId: {{isId}},
          isNullable: {{isNullable}},
        ),
{{/fields}}
      ],
    ),
{{/entities}}
  ];

  /// Procesa el mensaje del usuario 100% a través de Qwen Local On-Device
  /// sin estructuras predefinidas de salvaguarda ni motores regex secundarios.
  Future<ChatMessage> processMessage(String userText) async {
    final cleanInput = userText.trim();
    if (cleanInput.isEmpty) {
      return ChatMessage(
        id: DateTime.now().millisecondsSinceEpoch.toString(),
        text: 'Por favor escribe una instrucción o pregunta.',
        sender: MessageSender.bot,
        timestamp: DateTime.now(),
      );
    }

    // 1. Validar disponibilidad de Qwen Local
    if (_localLlmService == null || !_localLlmService!.isModelLoaded) {
      return ChatMessage(
        id: DateTime.now().millisecondsSinceEpoch.toString(),
        text: '⚠️ **El modelo local Qwen no está cargado.**\n\n'
            'Para interactuar con la IA de forma local y privada en tu dispositivo, '
            'descárgalo o inicialízalo usando el botón en la parte superior.',
        sender: MessageSender.bot,
        timestamp: DateTime.now(),
        isError: true,
      );
    }

    // 2. Consulta directa al LLM Qwen local on-device
    try {
      final llmResult = await _queryOnDeviceLlm(cleanInput);
      if (llmResult != null) {
        return await _executeStructuredAction(
          llmResult,
          usedEngine: 'Qwen2.5 Local On-Device',
          userPrompt: cleanInput,
        );
      }
    } catch (err) {
      return ChatMessage(
        id: DateTime.now().millisecondsSinceEpoch.toString(),
        text: '⚠️ Error durante la inferencia con Qwen local: $err',
        sender: MessageSender.bot,
        timestamp: DateTime.now(),
        isError: true,
      );
    }

    return ChatMessage(
      id: DateTime.now().millisecondsSinceEpoch.toString(),
      text: '⚠️ No se reconoció una instrucción CRUD válida.\n\n'
          'Prueba con comandos directos sobre los datos, por ejemplo:\n'
          '- _"Listar ${entities.isNotEmpty ? entities.first.plural : 'registros'}"_\n'
          '- _"Registra un ${entities.isNotEmpty ? entities.first.singular : 'registro'}..."_\n'
          '- _"Eliminar ${entities.isNotEmpty ? entities.first.singular : 'registro'} con id ..."_',
      sender: MessageSender.bot,
      timestamp: DateTime.now(),
      isError: true,
    );
  }

  Future<Map<String, dynamic>?> _queryOnDeviceLlm(String userPrompt) async {
    if (_localLlmService == null || !_localLlmService!.isModelLoaded) return null;

    final systemInstruction = '''
Eres el procesador de comandos CRUD de la aplicación {{projectName}}.
Tu única función es traducir la instrucción del usuario a una acción CRUD sobre la base de datos.
Responde ÚNICAMENTE con un objeto JSON sin texto antes ni después, sin markdown (```json), sin saludos ni explicaciones.

Entidades y recursos disponibles:
{{#entities}}
- {{name}} (endpoint: '{{endpoint}}'): campos [{{#fields}}{{name}} ({{type}}){{^last}}, {{/last}}{{/fields}}]
{{/entities}}

Estructura requerida según la acción:
- Listar todos: {"action":"list","entity":"<nombre_entidad>"}
- Buscar por término/nombre: {"action":"list","entity":"<nombre_entidad>","query":"<valor>"}
- Consultar por ID: {"action":"get","entity":"<nombre_entidad>","id":"<id>"}
- Crear/Registrar: {"action":"create","entity":"<nombre_entidad>","data":{"<campo>":"<valor>"}}
- Actualizar/Editar: {"action":"update","entity":"<nombre_entidad>","id":"<id>","data":{"<campo>":"<valor>"}}
- Eliminar/Borrar: {"action":"delete","entity":"<nombre_entidad>","id":"<id>"}

REGLAS OBLIGATORIAS:
1. Responde SIEMPRE empezando con '{' y terminando con '}'.
2. Prohibido cualquier texto conversacional, saludos, explicaciones o repeticiones.
3. Si la instrucción no corresponde a crear, listar, buscar, actualizar o eliminar datos, responde exactamente:
{"action":"unknown"}
''';

    try {
      final response = await _localLlmService!.generateOneShot(
        systemInstruction,
        userPrompt,
        maxTokens: 160,
        temperature: 0.0,
      );

      final trimmed = response.trim();
      if (trimmed.isNotEmpty) {
        final cleanJson = _extractJsonFromString(trimmed);
        if (cleanJson != null && cleanJson.containsKey('action')) {
          return cleanJson;
        }
      }
    } catch (e) {
      rethrow;
    }

    return null;
  }

  static Map<String, dynamic>? _extractJsonFromString(String text) {
    try {
      var cleaned = text.trim();

      // 1. Eliminar bloques markdown ```json ... ``` o ``` ... ```
      if (cleaned.startsWith('```')) {
        final firstNewline = cleaned.indexOf('\n');
        if (firstNewline != -1) {
          cleaned = cleaned.substring(firstNewline + 1);
        }
        if (cleaned.endsWith('```')) {
          cleaned = cleaned.substring(0, cleaned.length - 3);
        }
        cleaned = cleaned.trim();
      }

      // 2. Extraer el primer bloque JSON delimitado por llaves
      final start = cleaned.indexOf('{');
      final end = cleaned.lastIndexOf('}');
      if (start != -1 && end != -1 && end > start) {
        final jsonStr = cleaned.substring(start, end + 1);
        final decoded = jsonDecode(jsonStr);
        if (decoded is Map) {
          return Map<String, dynamic>.from(decoded);
        }
      }
    } catch (_) {}
    return null;
  }

  Future<ChatMessage> _executeStructuredAction(
    Map<String, dynamic> parsed, {
    required String usedEngine,
    String? userPrompt,
  }) async {
    final now = DateTime.now();
    final action = parsed['action']?.toString() ?? 'unknown';

    if (action == 'unknown') {
      return ChatMessage(
        id: now.millisecondsSinceEpoch.toString(),
        text: '⚠️ **Comando no interpretado como acción CRUD.**\n\n'
            'El asistente está configurado exclusivamente para gestionar los datos de la app:\n'
            '- _"Listar ${entities.isNotEmpty ? entities.first.plural : 'registros'}"_\n'
            '- _"Registra un ${entities.isNotEmpty ? entities.first.singular : 'registro'}..."_\n'
            '- _"Eliminar ${entities.isNotEmpty ? entities.first.singular : 'registro'} con id ..."_',
        sender: MessageSender.bot,
        timestamp: now,
      );
    }

    final entityName = parsed['entity']?.toString().toLowerCase().trim() ?? '';
    final entity = entities.firstWhere(
      (e) => _normalize(e.singular) == _normalize(entityName) || _normalize(e.name) == _normalize(entityName),
      orElse: () => entities.first,
    );

    try {
      if (action == 'create') {
        final data = Map<String, dynamic>.from(parsed['data'] ?? {});
        if (data.isEmpty) {
          final fieldsHelp = entity.fields.where((f) => !f.isId).map((f) => f.name).join(', ');
          return ChatMessage(
            id: now.millisecondsSinceEpoch.toString(),
            text: '⚠️ Qwen identificó la creación de **${entity.name}**, pero no se detectaron los datos.\n'
                'Campos disponibles: `$fieldsHelp`',
            sender: MessageSender.bot,
            timestamp: now,
            isError: true,
          );
        }

        final response = await apiClient.post(entity.endpoint, data: data);
        final responseData = response.data is Map ? response.data : {'id': 'Guardado'};

        final idFields = entity.fields.where((f) => f.isId);
        final idField = idFields.isNotEmpty ? idFields.first : null;
        dynamic createdId;
        if (responseData is Map) {
          if (idField != null && responseData[idField.name] != null) {
            createdId = responseData[idField.name];
          }
          createdId ??= responseData['id'] ?? responseData['ID'];
        }

        final buffer = StringBuffer();
        buffer.writeln('✅ **¡${entity.name} guardado exitosamente en el backend!**\n');
        buffer.writeln('📋 **Datos registrados:**\n');
        if (createdId != null) {
          buffer.writeln('- **id:** $createdId');
        }
        data.forEach((k, v) {
          if (k.toLowerCase() != 'id') {
            buffer.writeln('- **$k:** $v');
          }
        });
        buffer.writeln('\n_Procesado vía ${usedEngine}_');

        final fullActionData = Map<String, dynamic>.from(data);
        if (createdId != null) {
          fullActionData['id'] = createdId;
        }

        return ChatMessage(
          id: now.millisecondsSinceEpoch.toString(),
          text: buffer.toString(),
          sender: MessageSender.bot,
          timestamp: now,
          actionType: 'create',
          entityName: entity.name,
          actionData: fullActionData,
        );
      }

      if (action == 'update') {
        final id = parsed['id']?.toString().trim() ?? '';
        final data = Map<String, dynamic>.from(parsed['data'] ?? {});

        if (id.isEmpty) {
          return ChatMessage(
            id: now.millisecondsSinceEpoch.toString(),
            text: '⚠️ Debes especificar el ID de **${entity.name}** a actualizar.',
            sender: MessageSender.bot,
            timestamp: now,
            isError: true,
          );
        }

        if (data.isEmpty) {
          final fieldsHelp = entity.fields.where((f) => !f.isId).map((f) => f.name).join(', ');
          return ChatMessage(
            id: now.millisecondsSinceEpoch.toString(),
            text: '⚠️ No se detectaron campos para actualizar en **${entity.name}**.\n'
                'Campos disponibles: `$fieldsHelp`',
            sender: MessageSender.bot,
            timestamp: now,
            isError: true,
          );
        }

        final response = await apiClient.put('${entity.endpoint}/$id', data: data);
        final responseData = response.data is Map ? response.data : {'id': id};

        final buffer = StringBuffer();
        buffer.writeln('✏️ **¡${entity.name} actualizado exitosamente!**\n');
        buffer.writeln('- **ID:** `${responseData['id'] ?? id}`');
        buffer.writeln('\n📋 **Campos modificados:**\n');
        data.forEach((k, v) {
          buffer.writeln('- **$k:** $v');
        });
        buffer.writeln('\n_Procesado vía ${usedEngine}_');

        return ChatMessage(
          id: now.millisecondsSinceEpoch.toString(),
          text: buffer.toString(),
          sender: MessageSender.bot,
          timestamp: now,
          actionType: 'update',
          entityName: entity.name,
          actionData: data,
        );
      }

      if (action == 'list') {
        final response = await apiClient.get(entity.endpoint);
        final list = response.data is List ? (response.data as List) : [];

        if (list.isEmpty) {
          return ChatMessage(
            id: now.millisecondsSinceEpoch.toString(),
            text: 'ℹ️ Actualmente no hay registros guardados en **${entity.name}**.\n\n_Procesado vía ${usedEngine}_',
            sender: MessageSender.bot,
            timestamp: now,
            actionType: 'list',
            entityName: entity.name,
          );
        }

        final requestedFields = (parsed['fields'] is List)
            ? (parsed['fields'] as List).map((e) => e.toString().trim()).where((e) => e.isNotEmpty).toList()
            : <String>[];

        final searchQuery = (parsed['query'] ?? '').toString().trim();

        // Búsqueda específica solicitada por Qwen
        if (searchQuery.isNotEmpty) {
          final matches = list.where((item) => item is Map && _itemMatchesQuery(item, searchQuery)).toList();

          if (matches.isEmpty) {
            return ChatMessage(
              id: now.millisecondsSinceEpoch.toString(),
              text: '🔍 No se encontró ningún registro en **${entity.name}** que coincida con "**$searchQuery**" en el backend.\n\n_Procesado vía ${usedEngine}_',
              sender: MessageSender.bot,
              timestamp: now,
              actionType: 'list',
              entityName: entity.name,
            );
          }

          final targetItem = matches.first as Map;
          final itemTitle = _resolveDisplayTitle(targetItem, entity, 1);
          final buffer = StringBuffer();

          if (requestedFields.isNotEmpty) {
            buffer.writeln('Datos de **$itemTitle**:\n');
            for (final fieldName in requestedFields) {
              final val = _findFieldValue(targetItem, fieldName, entity);
              buffer.writeln('- **$fieldName:** $val');
            }
          } else {
            buffer.writeln('Información encontrada para **$itemTitle**:\n');
            targetItem.forEach((k, v) {
              buffer.writeln('- **$k:** $v');
            });
          }

          buffer.writeln('\n_Procesado vía ${usedEngine}_');

          return ChatMessage(
            id: now.millisecondsSinceEpoch.toString(),
            text: buffer.toString(),
            sender: MessageSender.bot,
            timestamp: now,
            actionType: 'list',
            entityName: entity.name,
            actionData: targetItem is Map<String, dynamic> ? targetItem : Map<String, dynamic>.from(targetItem),
          );
        }

        // Listado general
        final buffer = StringBuffer();
        if (requestedFields.isNotEmpty) {
          final fieldsLabel = requestedFields.join(', ');
          buffer.writeln('Registros en **${entity.name}** (*$fieldsLabel*):\n');

          for (var i = 0; i < list.length && i < 25; i++) {
            final rawItem = list[i];
            if (rawItem is Map) {
              final title = _resolveDisplayTitle(rawItem, entity, i + 1);
              buffer.writeln('${i + 1}. **$title**');
              for (final fieldName in requestedFields) {
                final val = _findFieldValue(rawItem, fieldName, entity);
                buffer.writeln('   - **$fieldName:** $val');
              }
            } else {
              buffer.writeln('${i + 1}. $rawItem');
            }
          }

          if (list.length > 25) {
            buffer.writeln('\n_...y ${list.length - 25} registros más._');
          }
          buffer.writeln('\n_Total: ${list.length} registros._');
        } else {
          buffer.writeln('Registros en **${entity.name}**:\n');
          for (var i = 0; i < list.length && i < 15; i++) {
            final rawItem = list[i];
            if (rawItem is Map) {
              final title = _resolveDisplayTitle(rawItem, entity, i + 1);
              final subtitle = _resolveDisplaySubtitle(rawItem, entity);
              if (subtitle.isNotEmpty) {
                buffer.writeln('${i + 1}. **$title** — $subtitle');
              } else {
                buffer.writeln('${i + 1}. **$title**');
              }
            } else {
              buffer.writeln('${i + 1}. **$rawItem**');
            }
          }

          if (list.length > 15) {
            buffer.writeln('\n_...y ${list.length - 15} registros más._');
          }
          buffer.writeln('\n_Total: ${list.length} registros._');
        }

        buffer.writeln('\n_Procesado vía ${usedEngine}_');

        return ChatMessage(
          id: now.millisecondsSinceEpoch.toString(),
          text: buffer.toString(),
          sender: MessageSender.bot,
          timestamp: now,
          actionType: 'list',
          entityName: entity.name,
        );
      }

      if (action == 'get') {
        final id = parsed['id']?.toString().trim() ?? '';
        if (id.isEmpty) {
          return ChatMessage(
            id: now.millisecondsSinceEpoch.toString(),
            text: '⚠️ Debes especificar el ID de **${entity.name}** a consultar.',
            sender: MessageSender.bot,
            timestamp: now,
            isError: true,
          );
        }

        final response = await apiClient.get('${entity.endpoint}/$id');
        final item = response.data is Map<String, dynamic>
            ? (response.data as Map<String, dynamic>)
            : <String, dynamic>{};

        final buffer = StringBuffer();
        final itemTitle = _resolveDisplayTitle(item, entity, 1);
        buffer.writeln('Información de **$itemTitle** (ID: `$id`):\n');
        if (item.isEmpty) {
          buffer.writeln('- **ID:** `$id`');
        } else {
          item.forEach((k, v) {
            buffer.writeln('- **$k:** $v');
          });
        }
        buffer.writeln('\n_Procesado vía ${usedEngine}_');

        return ChatMessage(
          id: now.millisecondsSinceEpoch.toString(),
          text: buffer.toString(),
          sender: MessageSender.bot,
          timestamp: now,
          actionType: 'get',
          entityName: entity.name,
          actionData: item,
        );
      }

      if (action == 'delete') {
        final id = parsed['id']?.toString().trim() ?? '';
        if (id.isEmpty) {
          return ChatMessage(
            id: now.millisecondsSinceEpoch.toString(),
            text: '⚠️ Debes especificar el ID de **${entity.name}** a eliminar.',
            sender: MessageSender.bot,
            timestamp: now,
            isError: true,
          );
        }

        await apiClient.delete('${entity.endpoint}/$id');
        return ChatMessage(
          id: now.millisecondsSinceEpoch.toString(),
          text: '🗑️ **${entity.name}** con ID `$id` eliminado exitosamente del backend.\n\n_Procesado vía ${usedEngine}_',
          sender: MessageSender.bot,
          timestamp: now,
          actionType: 'delete',
          entityName: entity.name,
          actionData: {'id': id},
        );
      }
    } catch (e) {
      final naturalExplanation = await _formatErrorInNaturalLanguage(
        e,
        action: action,
        entity: entity,
        data: parsed['data'],
      );

      return ChatMessage(
        id: now.millisecondsSinceEpoch.toString(),
        text: naturalExplanation,
        sender: MessageSender.bot,
        timestamp: now,
        isError: true,
      );
    }

    return ChatMessage(
      id: now.millisecondsSinceEpoch.toString(),
      text: parsed['message']?.toString() ?? 'Comando procesado.',
      sender: MessageSender.bot,
      timestamp: now,
    );
  }

  Future<String> _formatErrorInNaturalLanguage(
    dynamic error, {
    required String action,
    required EntitySchema entity,
    dynamic data,
  }) async {
    int? statusCode;
    String technicalDetail = error.toString();

    if (error is DioException) {
      statusCode = error.response?.statusCode;
      final resData = error.response?.data;
      if (resData != null) {
        if (resData is Map) {
          final msg = resData['message'] ?? resData['error'] ?? resData['detail'];
          technicalDetail = msg?.toString() ?? jsonEncode(resData);
        } else if (resData is String && resData.isNotEmpty) {
          technicalDetail = resData;
        }
      } else if (error.message != null && error.message!.isNotEmpty) {
        technicalDetail = error.message!;
      }
    }

    final codeSuffix = statusCode != null ? ' (HTTP $statusCode)' : '';
    return '❌ **Error al ejecutar $action en ${entity.name}$codeSuffix:**\n\n$technicalDetail';
  }

  static dynamic _findFieldValue(Map item, String targetField, EntitySchema entity) {
    final normTarget = _normalize(targetField);
    for (final entry in item.entries) {
      if (_normalize(entry.key.toString()) == normTarget) {
        return entry.value ?? '—';
      }
    }
    return '—';
  }

  static bool _itemMatchesQuery(Map item, String query) {
    final q = _normalize(query.trim());
    if (q.isEmpty) return false;
    for (final v in item.values) {
      if (v == null) continue;
      final valStr = _normalize(v.toString());
      if (valStr.contains(q)) return true;
    }
    return false;
  }

  static String _resolveDisplayTitle(Map item, EntitySchema entity, int index) {
    final titleCandidates = [
      'nombre', 'name', 'nombrecompleto', 'fullname', 'title', 'titulo',
      'descripcion', 'description', 'codigo', 'code', 'denominacion',
    ];

    for (final cand in titleCandidates) {
      for (final entry in item.entries) {
        if (_normalize(entry.key.toString()) == cand && entry.value != null && entry.value.toString().trim().isNotEmpty) {
          return entry.value.toString();
        }
      }
    }

    for (final f in entity.fields) {
      if (!f.isId && f.type == 'String') {
        for (final entry in item.entries) {
          if (_normalize(entry.key.toString()) == _normalize(f.name) && entry.value != null) {
            return entry.value.toString();
          }
        }
      }
    }

    return 'Registro #$index';
  }

  static String _resolveDisplaySubtitle(Map item, EntitySchema entity) {
    final subtitleCandidates = [
      'email', 'correo', 'precio', 'price', 'total', 'monto', 'fecharegistro',
      'orderdate', 'fecha', 'date', 'estado', 'status', 'telefono', 'phone', 'address', 'direccion',
    ];

    for (final cand in subtitleCandidates) {
      for (final entry in item.entries) {
        if (_normalize(entry.key.toString()) == cand && entry.value != null && entry.value.toString().trim().isNotEmpty) {
          return '${entry.key}: ${entry.value}';
        }
      }
    }

    return '';
  }

  static String _normalize(String text) {
    return text
        .toLowerCase()
        .replaceAll('á', 'a')
        .replaceAll('é', 'e')
        .replaceAll('í', 'i')
        .replaceAll('ó', 'o')
        .replaceAll('ú', 'u')
        .replaceAll('ñ', 'n')
        .trim();
  }
}
