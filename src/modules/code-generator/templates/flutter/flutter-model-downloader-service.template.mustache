import 'dart:io';
import 'dart:async';
import 'package:dio/dio.dart';
import 'package:path_provider/path_provider.dart';

/// Service responsible for downloading and managing the local LLM model file.
class ModelDownloaderService {
  static const String modelFileName = 'qwen2.5-0.5b-instruct-q4_k_m.gguf';
  static const String modelUrl = 'https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf';
  static const int expectedFileSizeBytes = 397000000;

  /// Candidate shared storage locations where the model might already be stored
  /// on the device (shared across multiple test apps or pushed via ADB).
  static const List<String> candidateSharedPaths = [
    '/storage/emulated/0/Download/models/qwen2.5-0.5b-instruct-q4_k_m.gguf',
    '/sdcard/Download/models/qwen2.5-0.5b-instruct-q4_k_m.gguf',
    '/storage/emulated/0/Download/qwen2.5-0.5b-instruct-q4_k_m.gguf',
    '/sdcard/Download/qwen2.5-0.5b-instruct-q4_k_m.gguf',
    '/storage/emulated/0/Models/qwen2.5-0.5b-instruct-q4_k_m.gguf',
    '/sdcard/Models/qwen2.5-0.5b-instruct-q4_k_m.gguf',
  ];

  final Dio _dio;

  ModelDownloaderService({Dio? dio}) : _dio = dio ?? Dio();

  /// Gets the directory where models are stored in app-private storage.
  Future<Directory> _getModelsDirectory() async {
    final docsDir = await getApplicationDocumentsDirectory();
    final modelsDir = Directory('${docsDir.path}/models');
    if (!await modelsDir.exists()) {
      await modelsDir.create(recursive: true);
    }
    return modelsDir;
  }

  /// Returns the path to the model if it's already downloaded and verified, null otherwise.
  /// Checks shared external storage paths first so multiple apps on the same device
  /// do not have to re-download the ~400MB model.
  Future<String?> getModelPath() async {
    // 1. Check shared public paths
    for (final path in candidateSharedPaths) {
      try {
        final sharedFile = File(path);
        if (await sharedFile.exists()) {
          final size = await sharedFile.length();
          if (size > (expectedFileSizeBytes * 0.9)) {
            return sharedFile.path;
          }
        }
      } catch (_) {
        // Scoped storage or permission denial: continue checking other paths
      }
    }

    // 2. Check app-private directory
    try {
      final modelsDir = await _getModelsDirectory();
      final privateFile = File('${modelsDir.path}/$modelFileName');
      if (await privateFile.exists()) {
        final size = await privateFile.length();
        if (size > (expectedFileSizeBytes * 0.9)) {
          return privateFile.path;
        }
      }
    } catch (_) {}

    return null;
  }

  /// Checks if the model file exists either in shared storage or app-private storage.
  Future<bool> isModelDownloaded() async {
    final path = await getModelPath();
    return path != null;
  }

  /// Returns the size of the downloaded model in MB, or 0 if not downloaded.
  Future<int> getModelSizeMB() async {
    final path = await getModelPath();
    if (path != null) {
      try {
        final file = File(path);
        if (await file.exists()) {
          final sizeBytes = await file.length();
          return sizeBytes ~/ (1024 * 1024);
        }
      } catch (_) {}
    }
    return 0;
  }

  /// Deletes the cached model file and any temporary downloading files from app-private storage.
  Future<void> deleteModel() async {
    try {
      final modelsDir = await _getModelsDirectory();
      final file = File('${modelsDir.path}/$modelFileName');
      final tempFile = File('${modelsDir.path}/$modelFileName.downloading');

      if (await file.exists()) {
        await file.delete();
      }
      if (await tempFile.exists()) {
        await tempFile.delete();
      }
    } catch (_) {}
  }

  /// Downloads the model with resume support and progress reporting.
  /// Uses a `.downloading` file during the process.
  Future<String> downloadModel({required void Function(double progress) onProgress}) async {
    // If already available in shared storage or app private storage, return immediately
    final existingPath = await getModelPath();
    if (existingPath != null) {
      onProgress(1.0);
      return existingPath;
    }

    final modelsDir = await _getModelsDirectory();
    final finalFile = File('${modelsDir.path}/$modelFileName');
    final tempFile = File('${modelsDir.path}/$modelFileName.downloading');

    int downloadedBytes = 0;
    if (await tempFile.exists()) {
      downloadedBytes = await tempFile.length();
    }

    final options = Options(
      responseType: ResponseType.stream,
      headers: {
        'Accept-Encoding': 'gzip',
      },
    );

    // Support resuming download if a partial temp file exists
    if (downloadedBytes > 0) {
      options.headers?['Range'] = 'bytes=$downloadedBytes-';
    }

    try {
      final response = await _dio.get<ResponseBody>(
        modelUrl,
        options: options,
      );

      final contentLengthHeader = response.headers.value(HttpHeaders.contentLengthHeader) ?? '';
      final newBytesToDownload = int.tryParse(contentLengthHeader) ?? 0;
      final totalBytes = newBytesToDownload > 0 ? (newBytesToDownload + downloadedBytes) : expectedFileSizeBytes;
      
      final sink = tempFile.openWrite(mode: downloadedBytes > 0 ? FileMode.append : FileMode.write);
      final stream = response.data?.stream;
      
      if (stream != null) {
        await for (final chunk in stream) {
          sink.add(chunk);
          downloadedBytes += chunk.length;
          
          if (totalBytes > 0) {
            final progress = (downloadedBytes / totalBytes).clamp(0.0, 1.0);
            onProgress(progress);
          } else {
            // Fallback progress based on expected size if total size is missing
            onProgress((downloadedBytes / expectedFileSizeBytes).clamp(0.0, 1.0));
          }
        }
      }

      await sink.close();

      // Rename temporary file to final model name upon completion
      if (await tempFile.exists()) {
        await tempFile.rename(finalFile.path);
      }
      
      // Best-effort attempt to mirror to shared /sdcard/Download/models so future apps can reuse it
      try {
        final sharedDir = Directory('/storage/emulated/0/Download/models');
        if (!await sharedDir.exists()) {
          await sharedDir.create(recursive: true);
        }
        final sharedTarget = File('${sharedDir.path}/$modelFileName');
        if (!await sharedTarget.exists()) {
          await finalFile.copy(sharedTarget.path);
        }
      } catch (_) {
        // Silently ignore if scoped storage prevents copying to shared directory
      }

      onProgress(1.0);
      return finalFile.path;
      
    } on DioException catch (e) {
      // 416 Range Not Satisfiable means the range requested is invalid, 
      // possibly because the file changed or is already fully downloaded.
      if (e.response?.statusCode == 416) {
        if (await tempFile.exists()) {
           await tempFile.delete();
        }
        // Retry the download from scratch
        return downloadModel(onProgress: onProgress);
      }
      rethrow;
    } catch (e) {
      rethrow;
    }
  }
}
