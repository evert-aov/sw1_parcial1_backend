import 'package:flutter/material.dart';
import 'package:flutter_bloc/flutter_bloc.dart';
import '../bloc/auth_bloc.dart';

class ProfilePage extends StatelessWidget {
  const ProfilePage({super.key});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return Scaffold(
      appBar: AppBar(
        title: const Text('Mi Perfil'),
      ),
      body: BlocBuilder<AuthBloc, AuthState>(
        builder: (context, state) {
          String displayName = 'Usuario';
          String email = '';
          String idStr = '';
          String initial = 'U';

          if (state is Authenticated && state.user != null) {
            final u = state.user!;
            idStr = u.id.toString();
            final nameParts = [
              {{#nameGetter}}if ({{nameGetter}} != null && {{nameGetter}}!.toString().trim().isNotEmpty) {{nameGetter}}!.toString().trim(),{{/nameGetter}}
              {{#lastNameGetter}}if ({{lastNameGetter}} != null && {{lastNameGetter}}!.toString().trim().isNotEmpty) {{lastNameGetter}}!.toString().trim(),{{/lastNameGetter}}
            ];

            if (nameParts.isNotEmpty) {
              displayName = nameParts.join(' ');
            } else if ({{#emailGetter}}{{emailGetter}} != null && {{emailGetter}}!.isNotEmpty{{/emailGetter}}{{^emailGetter}}false{{/emailGetter}}) {
              displayName = {{#emailGetter}}{{emailGetter}}!.split('@').first{{/emailGetter}};
            }

            {{#emailGetter}}
            if ({{emailGetter}} != null) {
              email = {{emailGetter}}!;
            }
            {{/emailGetter}}

            if (displayName.trim().isNotEmpty) {
              initial = displayName.trim()[0].toUpperCase();
            }
          }

          return Center(
            child: SingleChildScrollView(
              padding: const EdgeInsets.all(24),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  CircleAvatar(
                    radius: 48,
                    backgroundColor: theme.colorScheme.primary.withValues(alpha: 0.15),
                    child: Text(
                      initial,
                      style: theme.textTheme.headlineLarge?.copyWith(
                        color: theme.colorScheme.primary,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                  const SizedBox(height: 18),
                  Text(
                    displayName,
                    textAlign: TextAlign.center,
                    style: theme.textTheme.headlineSmall?.copyWith(
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  if (email.isNotEmpty) ...[
                    const SizedBox(height: 6),
                    Text(
                      email,
                      style: TextStyle(
                        fontSize: 14,
                        color: Colors.grey[600],
                      ),
                    ),
                  ],
                  if (idStr.isNotEmpty) ...[
                    const SizedBox(height: 8),
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 3),
                      decoration: BoxDecoration(
                        color: theme.colorScheme.surfaceContainerHighest,
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: Text(
                        'ID: $idStr',
                        style: TextStyle(
                          fontSize: 12,
                          color: Colors.grey[700],
                          fontWeight: FontWeight.w500,
                        ),
                      ),
                    ),
                  ],
                  const SizedBox(height: 16),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
                    decoration: BoxDecoration(
                      color: Colors.green.withValues(alpha: 0.12),
                      borderRadius: BorderRadius.circular(20),
                      border: Border.all(color: Colors.green.withValues(alpha: 0.4)),
                    ),
                    child: const Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Icon(Icons.check_circle_rounded, size: 16, color: Colors.green),
                        SizedBox(width: 6),
                        Text(
                          'Conectado actualmente',
                          style: TextStyle(
                            fontSize: 13,
                            color: Colors.green,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(height: 12),
                  Text(
                    'Autenticado mediante Token JWT en {{projectName}}',
                    textAlign: TextAlign.center,
                    style: TextStyle(fontSize: 12, color: Colors.grey[500]),
                  ),
                  const SizedBox(height: 36),
                  SizedBox(
                    width: double.infinity,
                    child: FilledButton.icon(
                      style: FilledButton.styleFrom(
                        backgroundColor: theme.colorScheme.error,
                        foregroundColor: Colors.white,
                        padding: const EdgeInsets.symmetric(vertical: 14),
                      ),
                      onPressed: () {
                        context.read<AuthBloc>().add(LogoutSubmitted());
                        Navigator.pop(context);
                      },
                      icon: const Icon(Icons.logout),
                      label: const Text(
                        'CERRAR SESIÓN',
                        style: TextStyle(fontWeight: FontWeight.bold),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          );
        },
      ),
    );
  }
}
